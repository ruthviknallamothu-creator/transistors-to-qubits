<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>From Transistors to Qubits</title>
    
    <!-- React & ReactDOM -->
    <script src="https://unpkg.com/react@18/umd/react.production.min.js" crossorigin></script>
    <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js" crossorigin></script>
    
    <!-- Babel for JSX -->
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = { darkMode: 'class', theme: { extend: { colors: {
            brand: { 400: '#60a5fa', 500: '#3b82f6', 600: '#2563eb' }
        }}}}
    </script>

    <!-- KaTeX for Math rendering -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.css">
    <script src="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.js"></script>
    
    <!-- Google Material Icons (React Safe) -->
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet" />

    <style>
        body { background-color: #0f172a; color: #f8fafc; font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, sans-serif; }
        .katex { font-size: 1.1em; }
        .fade-in { animation: fadeIn 0.4s ease-in-out; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(5px); } to { opacity: 1; transform: translateY(0); } }
        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: #1e293b; }
        ::-webkit-scrollbar-thumb { background: #475569; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #64748b; }
        
        /* Icon Alignment */
        .material-symbols-outlined { font-size: 20px; vertical-align: middle; }
    </style>
</head>
<body>
    <div id="root"></div>

    <script type="text/babel">
        const { useState, useEffect, useRef, useMemo } = React;

        // --- MATH & QUANTUM ENGINE ---
        class C {
            constructor(r, i=0) { this.r = r; this.i = i; }
            add(c) { return new C(this.r + c.r, this.i + c.i); }
            sub(c) { return new C(this.r - c.r, this.i - c.i); }
            mul(c) { return new C(this.r*c.r - this.i*c.i, this.r*c.i + this.i*c.r); }
            mag2() { return this.r*this.r + this.i*this.i; }
            scale(s) { return new C(this.r*s, this.i*s); }
            format() { 
                let r = this.r.toFixed(2); let i = this.i.toFixed(2);
                if(i >= 0) return `${r} + ${i}i`; return `${r} - ${Math.abs(i).toFixed(2)}i`;
            }
        }
        
        const QMath = {
            normalize: (state) => {
                let mag = Math.sqrt(state.reduce((sum, c) => sum + c.mag2(), 0));
                return state.map(c => c.scale(1/mag));
            },
            // Gates (2x2 matrices applied to target qubit)
            applyGate: (state, numQubits, gateMatrix, target, control = -1) => {
                let next = Array(1<<numQubits).fill(new C(0));
                let stride = 1 << (numQubits - 1 - target);
                let cStride = control >= 0 ? (1 << (numQubits - 1 - control)) : -1;
                
                for(let i=0; i<(1<<numQubits); i++) {
                    if(control >= 0 && (i & cStride) === 0) {
                        next[i] = state[i]; continue;
                    }
                    if((i & stride) === 0) {
                        let j = i | stride;
                        next[i] = state[i].mul(gateMatrix[0][0]).add(state[j].mul(gateMatrix[0][1]));
                        next[j] = state[i].mul(gateMatrix[1][0]).add(state[j].mul(gateMatrix[1][1]));
                    }
                }
                // Fill untouched controlled states
                if(control >= 0) {
                    for(let i=0; i<(1<<numQubits); i++) {
                        if((i & cStride) === 0) next[i] = state[i];
                    }
                }
                return next;
            }
        };

        const GATES = {
            X: [[new C(0), new C(1)], [new C(1), new C(0)]],
            Y: [[new C(0), new C(0,-1)], [new C(0,1), new C(0)]],
            Z: [[new C(1), new C(0)], [new C(0), new C(-1)]],
            H: [[new C(0.7071), new C(0.7071)], [new C(0.7071), new C(-0.7071)]],
            I: [[new C(1), new C(0)], [new C(0), new C(1)]]
        };

        // --- COMPONENTS ---
        const MathTex = ({ math, block = false }) => {
            const el = useRef();
            useEffect(() => { katex.render(math, el.current, { throwOnError: false, displayMode: block }); }, [math, block]);
            return <span ref={el} className={block ? 'my-2 block text-center' : ''} />;
        };

        const Card = ({ children, className = "" }) => (
            <div className={`bg-slate-800 rounded-xl border border-slate-700 p-6 shadow-lg ${className}`}>{children}</div>
        );

        const Button = ({ onClick, children, active=false, variant="primary", className="" }) => {
            const base = "px-4 py-2 rounded-lg font-medium transition-colors flex items-center justify-center gap-2";
            const variants = {
                primary: `bg-brand-600 hover:bg-brand-500 text-white ${active ? 'ring-2 ring-white' : ''}`,
                outline: `border border-slate-600 hover:bg-slate-700 text-slate-200 ${active ? 'bg-slate-700 border-brand-400' : ''}`
            };
            return <button onClick={onClick} className={`${base} ${variants[variant]} ${className}`}>{children}</button>;
        };

        const BarChart = ({ data }) => (
            <div className="flex h-40 items-end gap-4 mt-4 border-b border-l border-slate-600 p-2 pt-8 relative">
                <span className="absolute -left-8 top-0 text-xs text-slate-400">Prob</span>
                {data.map((d, i) => (
                    <div key={i} className="flex-1 flex flex-col items-center group">
                        <div className="text-xs text-slate-300 mb-1 opacity-0 group-hover:opacity-100 transition-opacity">{(d.val*100).toFixed(1)}%</div>
                        <div className="w-full bg-brand-500 rounded-t-sm transition-all duration-300 relative overflow-hidden" 
                             style={{height: `${Math.max(d.val * 100, 1)}%`}}>
                             <div className="absolute inset-0 bg-white/20 animate-pulse"></div>
                        </div>
                        <div className="mt-2 text-sm font-mono text-slate-400">{d.label}</div>
                    </div>
                ))}
            </div>
        );

        const BlochSphere = ({ theta, phi }) => {
            const r = 80;
            const x = r * Math.sin(theta) * Math.cos(phi);
            const y = r * Math.sin(theta) * Math.sin(phi);
            const z = r * Math.cos(theta);
            
            const px = x - y*0.5;
            const py = -z + y*0.3;

            return (
                <svg width="200" height="200" viewBox="-100 -100 200 200" className="mx-auto block drop-shadow-xl">
                    <circle cx="0" cy="0" r={r} fill="none" stroke="#475569" strokeWidth="2"/>
                    <ellipse cx="0" cy="0" rx={r} ry={r*0.3} fill="none" stroke="#475569" strokeWidth="1" strokeDasharray="4,4"/>
                    <line x1="0" y1={-r} x2="0" y2={r} stroke="#475569" strokeWidth="1"/>
                    <text x="-5" y={-r-10} fill="#94a3b8" fontSize="14">|0⟩</text>
                    <text x="-5" y={r+20} fill="#94a3b8" fontSize="14">|1⟩</text>
                    <line x1="0" y1="0" x2={px} y2={py} stroke="#3b82f6" strokeWidth="3" markerEnd="url(#arrowhead)"/>
                    <circle cx={px} cy={py} r="4" fill="#3b82f6"/>
                    <defs>
                        <marker id="arrowhead" markerWidth="6" markerHeight="6" refX="3" refY="3" orient="auto">
                            <polygon points="0 0, 6 3, 0 6" fill="#3b82f6" />
                        </marker>
                    </defs>
                </svg>
            );
        };

        // --- VIEWS ---

        const Home = ({ setPage }) => (
            <div className="fade-in max-w-3xl mx-auto text-center mt-12">
                <div className="inline-block p-4 rounded-2xl bg-brand-500/10 mb-6">
                    <span className="material-symbols-outlined text-6xl text-brand-400">memory</span>
                </div>
                <h1 className="text-5xl font-bold mb-6 text-transparent bg-clip-text bg-gradient-to-r from-brand-400 to-purple-400">
                    From Transistors to Qubits
                </h1>
                <p className="text-xl text-slate-300 mb-10 leading-relaxed">
                    A hybrid learning framework for electronics engineers bridging the conceptual gap between semiconductor logic and quantum computing. 
                    Leverage your knowledge of digital circuits to master quantum states, superposition, and entanglement.
                </p>
                <div className="flex justify-center gap-4">
                    <Button onClick={() => setPage('map')}><span className="material-symbols-outlined">map</span> View Concept Map</Button>
                    <Button onClick={() => setPage('lvl1')}><span className="material-symbols-outlined">play_arrow</span> Start Level 1</Button>
                </div>
            </div>
        );

        const ConceptMap = ({ setPage }) => {
            const rows = [
                { c: "Transistor", k: "Electronic switching device", q: "Qubit as quantum information unit", p: 'lvl1' },
                { c: "ON/OFF (Voltage)", k: "0 or 1 logical states", q: "|0⟩ or |1⟩ basis states (Measurement result)", p: 'lvl3' },
                { c: "Voltage Level", k: "Physical representation of information", q: "Quantum state vector (Probability amplitudes)", p: 'lvl3' },
                { c: "Logic Gate", k: "AND, OR, NOT operations", q: "Quantum Gates (X, Y, Z, H, CNOT)", p: 'lvl2' },
                { c: "NOT Gate", k: "Inverts 0 ↔ 1", q: "Pauli-X Gate (Bit flip)", p: 'lvl2' },
                { c: "Digital Circuit", k: "Combination of logic gates", q: "Quantum Circuit", p: 'lvl4' },
                { c: "Measurement", k: "Reading voltage on a pin", q: "Quantum Measurement (Collapses superposition)", p: 'modC' },
                { c: "Noise", k: "Signal distortion (Threshold limits)", q: "Decoherence & Quantum errors", p: 'noise' }
            ];

            return (
                <div className="fade-in">
                    <h2 className="text-3xl font-bold mb-6">Concept Mapping</h2>
                    <p className="text-slate-400 mb-8">Hover over concepts to compare your existing knowledge with quantum equivalents. Click a row to jump to its interactive module.</p>
                    <div className="overflow-x-auto">
                        <table className="w-full text-left border-collapse">
                            <thead>
                                <tr className="border-b-2 border-slate-700 text-slate-300">
                                    <th className="p-4">Electronics Concept</th>
                                    <th className="p-4">What You Know</th>
                                    <th className="p-4 text-brand-400">Quantum Counterpart</th>
                                </tr>
                            </thead>
                            <tbody>
                                {rows.map((r, i) => (
                                    <tr key={i} onClick={() => setPage(r.p)} className="border-b border-slate-800 hover:bg-slate-800/50 cursor-pointer transition-colors group">
                                        <td className="p-4 font-medium text-slate-200 group-hover:text-white">{r.c}</td>
                                        <td className="p-4 text-slate-400 group-hover:text-slate-300">{r.k}</td>
                                        <td className="p-4 text-brand-300 font-medium">{r.q}</td>
                                    </tr>
                                ))}
                            </tbody>
                        </table>
                    </div>
                </div>
            );
        };

        const Level1 = ({ setPage }) => {
            const [vin, setVin] = useState(0);
            const vth = 0.7; // Threshold for simple BJT model
            const isOn = vin > vth;

            return (
                <div className="fade-in max-w-4xl mx-auto">
                    <h2 className="text-3xl font-bold mb-2">Level 1: The Transistor</h2>
                    <p className="text-slate-400 mb-6">The fundamental building block of classical computation.</p>
                    
                    <div className="grid md:grid-cols-2 gap-8">
                        <Card className="flex flex-col items-center">
                            <h3 className="text-xl font-semibold mb-4 w-full">Circuit Simulation</h3>
                            <svg width="250" height="200" viewBox="0 0 250 200" className="mb-4">
                                {/* Vcc */}
                                <line x1="125" y1="20" x2="125" y2="40" stroke="#94a3b8" strokeWidth="2"/>
                                <circle cx="125" cy="20" r="4" fill="#ef4444"/>
                                <text x="135" y="25" fill="#ef4444" fontSize="12">Vcc (5V)</text>
                                
                                {/* Resistor */}
                                <polyline points="125,40 120,45 130,55 120,65 130,75 125,80" fill="none" stroke="#94a3b8" strokeWidth="2"/>
                                
                                {/* LED */}
                                <polygon points="115,80 135,80 125,100" fill={isOn ? "#22c55e" : "#475569"} stroke="#94a3b8" strokeWidth="2"/>
                                <line x1="115" y1="100" x2="135" y2="100" stroke="#94a3b8" strokeWidth="2"/>
                                {isOn && <circle cx="125" cy="90" r="20" fill="#22c55e" opacity="0.2" className="animate-ping"/>}

                                {/* Transistor BJT NPN */}
                                <line x1="125" y1="100" x2="125" y2="120" stroke="#94a3b8" strokeWidth="2"/>
                                <line x1="110" y1="120" x2="110" y2="160" stroke="#94a3b8" strokeWidth="4"/>
                                <line x1="110" y1="130" x2="125" y2="120" stroke="#94a3b8" strokeWidth="2"/>
                                <line x1="110" y1="150" x2="125" y2="160" stroke="#94a3b8" strokeWidth="2"/>
                                {/* Emiter arrow */}
                                <polygon points="120,152 125,160 117,160" fill="#94a3b8"/> 
                                
                                {/* Base Input */}
                                <line x1="50" y1="140" x2="110" y2="140" stroke={vin>0 ? "#3b82f6" : "#94a3b8"} strokeWidth="2"/>
                                <circle cx="50" cy="140" r="4" fill="#3b82f6"/>
                                <text x="20" y="144" fill="#3b82f6" fontSize="12">Vin</text>

                                {/* GND */}
                                <line x1="125" y1="160" x2="125" y2="180" stroke="#94a3b8" strokeWidth="2"/>
                                <line x1="110" y1="180" x2="140" y2="180" stroke="#94a3b8" strokeWidth="2"/>
                                <line x1="115" y1="185" x2="135" y2="185" stroke="#94a3b8" strokeWidth="2"/>
                                <line x1="120" y1="190" x2="130" y2="190" stroke="#94a3b8" strokeWidth="2"/>
                            </svg>
                            
                            <div className="w-full mt-4">
                                <label className="block text-sm text-slate-400 mb-2">Input Voltage (Vin): {vin}V</label>
                                <input type="range" min="0" max="5" step="0.1" value={vin} onChange={(e)=>setVin(parseFloat(e.target.value))} className="w-full cursor-pointer accent-brand-500" />
                            </div>
                        </Card>

                        <div className="flex flex-col gap-4">
                            <Card>
                                <h3 className="text-xl font-semibold mb-2 text-brand-400">State Readout</h3>
                                <ul className="space-y-3 font-mono text-sm">
                                    <li className="flex justify-between border-b border-slate-700 pb-1"><span>Vin:</span> <span>{vin} V</span></li>
                                    <li className="flex justify-between border-b border-slate-700 pb-1"><span>Vbe:</span> <span>{isOn ? 0.7 : vin} V</span></li>
                                    <li className="flex justify-between border-b border-slate-700 pb-1"><span>State:</span> <span className={isOn ? 'text-green-400' : 'text-slate-500'}>{isOn ? 'SATURATION' : 'CUTOFF'}</span></li>
                                    <li className="flex justify-between border-b border-slate-700 pb-1"><span>Logical Bit:</span> <span className="text-xl font-bold">{isOn ? '1' : '0'}</span></li>
                                </ul>
                            </Card>
                            <Card className="bg-brand-900/20 border-brand-500/30">
                                <h4 className="font-bold text-brand-300 mb-2">Key Takeaway</h4>
                                <p className="text-sm text-slate-300">
                                    Classical computing relies on deterministic physical thresholds (e.g., 0.7V). Information is encoded physically as either entirely ON (1) or OFF (0).
                                </p>
                            </Card>
                            <Button onClick={()=>setPage('lvl2')} className="mt-auto w-full justify-center">Next: Logic Gates <span className="material-symbols-outlined">arrow_forward</span></Button>
                        </div>
                    </div>
                </div>
            );
        };

        const Level2 = ({ setPage }) => {
            const [input, setInput] = useState(0);
            
            return (
                <div className="fade-in max-w-5xl mx-auto">
                    <h2 className="text-3xl font-bold mb-2">Level 2: Logic Gates & Quantum Equivalents</h2>
                    <p className="text-slate-400 mb-6">Mapping boolean logic (NOT) to quantum operations (Pauli-X).</p>

                    <div className="grid md:grid-cols-2 gap-6">
                        <Card>
                            <h3 className="text-xl font-semibold mb-4 text-orange-400">Classical: NOT Gate</h3>
                            <div className="flex gap-4 items-center justify-center py-6">
                                <div className="text-center">
                                    <div className="text-sm mb-2 text-slate-400">Input A</div>
                                    <button onClick={() => setInput(input === 0 ? 1 : 0)} 
                                            className="w-16 h-16 rounded-xl bg-slate-700 border-2 border-slate-500 text-2xl font-bold hover:bg-slate-600 transition-all shadow-[0_0_15px_rgba(0,0,0,0.5)]">
                                        {input}
                                    </button>
                                </div>
                                <svg width="100" height="60" viewBox="0 0 100 60">
                                    <line x1="0" y1="30" x2="20" y2="30" stroke="#94a3b8" strokeWidth="3"/>
                                    <polygon points="20,10 20,50 60,30" fill="none" stroke="#f6ad55" strokeWidth="3"/>
                                    <circle cx="65" cy="30" r="5" fill="none" stroke="#f6ad55" strokeWidth="3"/>
                                    <line x1="70" y1="30" x2="100" y2="30" stroke="#94a3b8" strokeWidth="3"/>
                                </svg>
                                <div className="text-center">
                                    <div className="text-sm mb-2 text-slate-400">Output Q</div>
                                    <div className="w-16 h-16 rounded-xl bg-orange-500/20 border-2 border-orange-500 text-orange-400 flex items-center justify-center text-2xl font-bold">
                                        {input === 0 ? 1 : 0}
                                    </div>
                                </div>
                            </div>
                            <div className="mt-4 bg-slate-900 rounded p-4">
                                <MathTex math={`Q = \\overline{A}`} />
                            </div>
                        </Card>

                        <Card>
                            <h3 className="text-xl font-semibold mb-4 text-brand-400">Quantum: Pauli-X Gate</h3>
                            <div className="flex gap-4 items-center justify-center py-6">
                                <div className="text-center">
                                    <div className="text-sm mb-2 text-slate-400">State |ψ⟩</div>
                                    <button onClick={() => setInput(input === 0 ? 1 : 0)} 
                                            className="w-16 h-16 rounded-xl bg-slate-700 border-2 border-slate-500 text-xl font-bold hover:bg-slate-600 transition-all">
                                        |{input}⟩
                                    </button>
                                </div>
                                <svg width="100" height="60" viewBox="0 0 100 60">
                                    <line x1="0" y1="30" x2="30" y2="30" stroke="#94a3b8" strokeWidth="3"/>
                                    <rect x="30" y="10" width="40" height="40" fill="none" stroke="#3b82f6" strokeWidth="3"/>
                                    <text x="50" y="36" fill="#3b82f6" fontSize="20" textAnchor="middle" fontWeight="bold">X</text>
                                    <line x1="70" y1="30" x2="100" y2="30" stroke="#94a3b8" strokeWidth="3"/>
                                </svg>
                                <div className="text-center">
                                    <div className="text-sm mb-2 text-slate-400">State X|ψ⟩</div>
                                    <div className="w-16 h-16 rounded-xl bg-brand-500/20 border-2 border-brand-500 text-brand-400 flex items-center justify-center text-xl font-bold">
                                        |{input === 0 ? 1 : 0}⟩
                                    </div>
                                </div>
                            </div>
                            <div className="mt-4 bg-slate-900 rounded p-4 text-sm space-y-2">
                                <MathTex math={`X = \\begin{bmatrix} 0 & 1 \\\\ 1 & 0 \\end{bmatrix}`} />
                                <MathTex math={`X|0\\rangle = |1\\rangle \\quad X|1\\rangle = |0\\rangle`} />
                            </div>
                        </Card>
                    </div>

                    <Card className="mt-6 bg-brand-900/20 border-brand-500/30">
                        <div className="flex justify-between items-center">
                            <div>
                                <h4 className="font-bold text-brand-300 mb-1">Key Takeaway</h4>
                                <p className="text-sm text-slate-300">
                                    The Quantum X Gate performs exactly like a classical NOT gate when acting on basis states (|0⟩ and |1⟩). However, it operates via matrix multiplication on a state vector rather than altering a physical voltage.
                                </p>
                            </div>
                            <Button onClick={()=>setPage('lvl3')}>Next: Bit to Qubit <span className="material-symbols-outlined">arrow_forward</span></Button>
                        </div>
                    </Card>
                </div>
            );
        };

        const Level3 = ({ setPage }) => {
            const [theta, setTheta] = useState(0); 
            const [phi, setPhi] = useState(0);     

            const alpha_mag = Math.cos(theta/2);
            const beta_mag = Math.sin(theta/2);
            const prob0 = alpha_mag * alpha_mag;
            const prob1 = beta_mag * beta_mag;

            return (
                <div className="fade-in max-w-5xl mx-auto">
                    <h2 className="text-3xl font-bold mb-2">Level 3: From Bits to Qubits</h2>
                    <p className="text-slate-400 mb-6">Moving from discrete values (0, 1) to continuous probability amplitudes (Superposition).</p>

                    <div className="grid md:grid-cols-3 gap-6">
                        <Card className="md:col-span-1">
                            <h3 className="font-bold mb-4">State Controls</h3>
                            <div className="space-y-6">
                                <div>
                                    <label className="flex justify-between text-sm text-slate-400 mb-1">
                                        <span>θ (Theta)</span> <span>{(theta * 180 / Math.PI).toFixed(0)}°</span>
                                    </label>
                                    <input type="range" min="0" max={Math.PI} step="0.01" value={theta} onChange={e=>setTheta(parseFloat(e.target.value))} className="w-full accent-brand-500"/>
                                    <p className="text-xs text-slate-500 mt-1">Controls probability (0 to 1)</p>
                                </div>
                                <div>
                                    <label className="flex justify-between text-sm text-slate-400 mb-1">
                                        <span>φ (Phi)</span> <span>{(phi * 180 / Math.PI).toFixed(0)}°</span>
                                    </label>
                                    <input type="range" min="0" max={2*Math.PI} step="0.01" value={phi} onChange={e=>setPhi(parseFloat(e.target.value))} className="w-full accent-purple-500"/>
                                    <p className="text-xs text-slate-500 mt-1">Controls quantum phase</p>
                                </div>
                                <div className="p-3 bg-slate-900 rounded">
                                    <MathTex math={`|\\psi\\rangle = \\cos(\\frac{\\theta}{2})|0\\rangle + e^{i\\phi}\\sin(\\frac{\\theta}{2})|1\\rangle`} />
                                </div>
                                <div className="flex gap-2">
                                    <button onClick={()=>{setTheta(0);setPhi(0);}} className="flex-1 bg-slate-700 hover:bg-slate-600 rounded py-1 text-sm">|0⟩</button>
                                    <button onClick={()=>{setTheta(Math.PI);setPhi(0);}} className="flex-1 bg-slate-700 hover:bg-slate-600 rounded py-1 text-sm">|1⟩</button>
                                    <button onClick={()=>{setTheta(Math.PI/2);setPhi(0);}} className="flex-1 bg-slate-700 hover:bg-slate-600 rounded py-1 text-sm">|+⟩</button>
                                </div>
                            </div>
                        </Card>

                        <Card className="md:col-span-1 text-center flex flex-col items-center justify-center">
                            <h3 className="font-bold mb-4">Bloch Sphere</h3>
                            <BlochSphere theta={theta} phi={phi} />
                        </Card>

                        <Card className="md:col-span-1">
                            <h3 className="font-bold mb-4">Measurement Probabilities</h3>
                            <BarChart data={[
                                {label: '|0⟩', val: prob0}, 
                                {label: '|1⟩', val: prob1}
                            ]} />
                            <div className="mt-4 p-3 bg-slate-900 rounded text-sm text-center">
                                <MathTex math={`P(0) = |\\alpha|^2 = ${(prob0).toFixed(2)}`} block />
                                <MathTex math={`P(1) = |\\beta|^2 = ${(prob1).toFixed(2)}`} block />
                            </div>
                        </Card>
                    </div>

                    <Card className="mt-6 bg-brand-900/20 border-brand-500/30">
                        <div className="flex justify-between items-center">
                            <div>
                                <h4 className="font-bold text-brand-300 mb-1">Key Takeaway</h4>
                                <p className="text-sm text-slate-300">
                                    Unlike a transistor which is strictly at 0V or 5V, a qubit state resides anywhere on the surface of the Bloch sphere. Measurement forces it to snap (collapse) to |0⟩ or |1⟩ based on these probabilities.
                                </p>
                            </div>
                            <Button onClick={()=>setPage('modC')}>Next: Quantum Circuit <span className="material-symbols-outlined">arrow_forward</span></Button>
                        </div>
                    </Card>
                </div>
            );
        };

        const ModuleC = () => {
            const [numQubits, setNumQubits] = useState(2);
            const [circuit, setCircuit] = useState([[], [], []]); 
            const [state, setState] = useState(Array(1<<3).fill(new C(0)));
            const [shots, setShots] = useState(1024);
            const [results, setResults] = useState(null);

            useEffect(() => {
                let init = Array(1<<numQubits).fill(new C(0));
                init[0] = new C(1);
                setState(init);
                calculateState(circuit, numQubits);
            }, [numQubits]);

            const calculateState = (circ, qb) => {
                let current = Array(1<<qb).fill(new C(0));
                current[0] = new C(1);
                
                for(let col=0; col<5; col++) {
                    for(let q=0; q<qb; q++) {
                        let gateObj = circ[q][col];
                        if(gateObj) {
                            if(gateObj.type === 'CX' && gateObj.control !== undefined) {
                                current = QMath.applyGate(current, qb, GATES['X'], q, gateObj.control);
                            } else if (GATES[gateObj.type]) {
                                current = QMath.applyGate(current, qb, GATES[gateObj.type], q);
                            }
                        }
                    }
                }
                setState(current);
                setResults(null); 
            };

            const addGate = (q, col, type) => {
                let newCirc = [...circuit];
                if(type==='CX') {
                    let c = prompt(`Enter control qubit (0 to ${numQubits-1}) for CNOT on q${q}:`);
                    c = parseInt(c);
                    if(c >= 0 && c < numQubits && c !== q) {
                        newCirc[q][col] = { type, control: c };
                    }
                } else {
                    newCirc[q][col] = { type };
                }
                setCircuit(newCirc);
                calculateState(newCirc, numQubits);
            };

            const clearCol = (q, col) => {
                let newCirc = [...circuit];
                newCirc[q][col] = null;
                setCircuit(newCirc);
                calculateState(newCirc, numQubits);
            };

            const runMeasurement = () => {
                let res = {};
                for(let i=0; i<(1<<numQubits); i++) {
                    let bin = i.toString(2).padStart(numQubits, '0');
                    res[bin] = 0;
                }
                for(let s=0; s<shots; s++) {
                    let r = Math.random();
                    let accum = 0;
                    for(let i=0; i<(1<<numQubits); i++) {
                        accum += state[i].mag2();
                        if(r <= accum) {
                            let bin = i.toString(2).padStart(numQubits, '0');
                            res[bin]++;
                            break;
                        }
                    }
                }
                setResults(res);
            };

            const generateQiskit = () => {
                let code = `from qiskit import QuantumCircuit, Aer, execute\n\n`;
                code += `qc = QuantumCircuit(${numQubits})\n`;
                for(let col=0; col<5; col++) {
                    for(let q=0; q<numQubits; q++) {
                        let g = circuit[q][col];
                        if(g) {
                            if(g.type==='CX') code += `qc.cx(${g.control}, ${q})\n`;
                            else code += `qc.${g.type.toLowerCase()}(${q})\n`;
                        }
                    }
                }
                code += `qc.measure_all()\n`;
                code += `simulator = Aer.get_backend('aer_simulator')\n`;
                code += `result = execute(qc, simulator, shots=${shots}).result()\n`;
                code += `print(result.get_counts())\n`;
                return code;
            };

            return (
                <div className="fade-in max-w-6xl mx-auto">
                    <div className="flex justify-between items-end mb-6">
                        <div>
                            <h2 className="text-3xl font-bold">Quantum Simulator (Statevector)</h2>
                            <p className="text-slate-400">Build a circuit and see the complex amplitudes evolve.</p>
                        </div>
                        <div className="flex items-center gap-2">
                            <label className="text-sm">Qubits:</label>
                            <select value={numQubits} onChange={e=>setNumQubits(parseInt(e.target.value))} className="bg-slate-700 rounded p-1">
                                <option value={1}>1</option><option value={2}>2</option><option value={3}>3</option>
                            </select>
                        </div>
                    </div>

                    <div className="grid lg:grid-cols-3 gap-6">
                        <Card className="lg:col-span-2">
                            <h3 className="font-bold mb-4">Circuit Editor</h3>
                            <div className="overflow-x-auto pb-4">
                                <div className="relative min-w-[500px]">
                                    {Array.from({length: numQubits}).map((_, q) => (
                                        <div key={q} className="flex items-center h-16 relative">
                                            <div className="w-12 font-mono font-bold text-slate-400">q_{q} |0⟩</div>
                                            <div className="flex-1 h-[2px] bg-slate-600 relative flex items-center">
                                                {Array.from({length: 5}).map((_, col) => {
                                                    const g = circuit[q][col];
                                                    return (
                                                        <div key={col} className="w-16 h-12 absolute -top-6 flex items-center justify-center group" style={{left: `${col * 20 + 5}%`}}>
                                                            {g ? (
                                                                <div onClick={()=>clearCol(q, col)} className="w-10 h-10 bg-brand-500 border border-brand-300 rounded flex items-center justify-center font-bold text-white cursor-pointer hover:bg-red-500 transition-colors z-10" title="Click to remove">
                                                                    {g.type}
                                                                </div>
                                                            ) : (
                                                                <div className="w-10 h-10 border-2 border-dashed border-slate-600 rounded flex items-center justify-center opacity-0 group-hover:opacity-100 cursor-pointer hover:bg-slate-700/50" z-10>
                                                                    <select className="opacity-0 absolute inset-0 cursor-pointer" onChange={(e)=> { if(e.target.value) addGate(q, col, e.target.value); e.target.value="";}}>
                                                                        <option value="">Add</option>
                                                                        <option value="H">H</option><option value="X">X</option><option value="Y">Y</option><option value="Z">Z</option><option value="CX">CNOT</option>
                                                                    </select>
                                                                    <span className="material-symbols-outlined text-slate-400">add</span>
                                                                </div>
                                                            )}
                                                            {g && g.type === 'CX' && (
                                                                <svg className="absolute w-2 h-32 pointer-events-none" style={{
                                                                    top: g.control < q ? `-${(q - g.control)*4}rem` : '10px', 
                                                                    height: `${Math.abs(q - g.control)*4}rem`,
                                                                    zIndex: 0
                                                                }}>
                                                                    <line x1="4" y1="0" x2="4" y2="100%" stroke="#3b82f6" strokeWidth="2"/>
                                                                    <circle cx="4" cy={g.control < q ? '4' : '100%'} r="4" fill="#3b82f6"/>
                                                                </svg>
                                                            )}
                                                        </div>
                                                    )
                                                })}
                                            </div>
                                        </div>
                                    ))}
                                </div>
                            </div>
                            <div className="mt-4 flex gap-4 border-t border-slate-700 pt-4">
                                <div className="flex-1">
                                    <label className="text-sm text-slate-400 mr-2">Shots:</label>
                                    <select value={shots} onChange={e=>setShots(parseInt(e.target.value))} className="bg-slate-700 rounded p-1 text-sm">
                                        <option value={100}>100</option><option value={1024}>1024</option><option value={10000}>10,000</option>
                                    </select>
                                </div>
                                <Button onClick={runMeasurement}><span className="material-symbols-outlined">bar_chart</span> Measure</Button>
                            </div>
                        </Card>

                        <div className="space-y-6">
                            <Card>
                                <h3 className="font-bold mb-2">Statevector</h3>
                                <div className="max-h-40 overflow-y-auto font-mono text-xs space-y-1 bg-slate-900 p-2 rounded">
                                    {state.slice(0, 1<<numQubits).map((c, i) => (
                                        <div key={i} className="flex justify-between border-b border-slate-800 pb-1">
                                            <span className="text-slate-500">|{i.toString(2).padStart(numQubits, '0')}⟩</span>
                                            <span className={c.mag2() > 0.001 ? "text-brand-300" : "text-slate-600"}>{c.format()}</span>
                                        </div>
                                    ))}
                                </div>
                            </Card>

                            <Card>
                                <h3 className="font-bold mb-2">Measurement Results</h3>
                                {results ? (
                                    <div className="flex h-32 items-end gap-2 border-b border-l border-slate-600 p-1">
                                        {Object.entries(results).map(([k, v]) => (
                                            <div key={k} className="flex-1 flex flex-col items-center">
                                                <div className="text-[10px] text-slate-400 mb-1">{v}</div>
                                                <div className="w-full bg-purple-500 rounded-t-sm" style={{height: `${(v/shots)*100}%`}}></div>
                                                <div className="mt-1 text-[10px] font-mono">{k}</div>
                                            </div>
                                        ))}
                                    </div>
                                ) : (
                                    <div className="h-32 flex items-center justify-center text-slate-500 text-sm border-2 border-dashed border-slate-700 rounded">
                                        Run measurement to see histogram
                                    </div>
                                )}
                            </Card>
                        </div>
                    </div>

                    <Card className="mt-6">
                        <div className="flex justify-between items-center mb-2">
                            <h3 className="font-bold">Equivalent Qiskit Code</h3>
                            <button onClick={()=>navigator.clipboard.writeText(generateQiskit())} className="text-xs text-brand-400 hover:text-brand-300 flex items-center gap-1">
                                <span className="material-symbols-outlined" style={{fontSize:'14px'}}>content_copy</span> Copy
                            </button>
                        </div>
                        <pre className="bg-slate-900 p-4 rounded text-sm text-green-400 overflow-x-auto">
                            <code>{generateQiskit()}</code>
                        </pre>
                    </Card>
                </div>
            );
        };

        const NoiseLab = () => {
            const [p, setP] = useState(0.1);
            const pUnprotected = 1 - p;
            const pProtected = Math.pow(1-p, 3) + 3*p*Math.pow(1-p, 2);

            return (
                <div className="fade-in max-w-5xl mx-auto">
                    <h2 className="text-3xl font-bold mb-2">Noise Lab</h2>
                    <p className="text-slate-400 mb-6">Compare classical signal noise with quantum decoherence and error correction.</p>

                    <div className="grid md:grid-cols-2 gap-6">
                        <Card>
                            <h3 className="text-xl font-bold mb-4 text-orange-400">Classical Noise Thresholding</h3>
                            <p className="text-sm text-slate-300 mb-4">Digital logic restores signals automatically as long as the noise doesn't cross the threshold voltage.</p>
                            
                            <svg width="100%" height="150" viewBox="0 0 400 150" className="bg-slate-900 rounded mb-4">
                                <line x1="0" y1="75" x2="400" y2="75" stroke="#ef4444" strokeWidth="1" strokeDasharray="4,4"/>
                                <text x="5" y="70" fill="#ef4444" fontSize="10">Threshold (2.5V)</text>
                                
                                <path d="M 0 120 L 50 120 L 50 30 L 150 30 L 150 120 L 250 120 L 250 30 L 350 30 L 350 120 L 400 120" fill="none" stroke="#f6ad55" strokeWidth="2" opacity="0.3"/>
                                
                                <path d={Array.from({length: 100}).map((_,i) => {
                                    let ideal = (i>12&&i<=37) || (i>62&&i<=87) ? 30 : 120;
                                    let noise = (Math.random() - 0.5) * p * 200;
                                    return `${i===0?'M':'L'} ${i*4} ${Math.max(10, Math.min(140, ideal + noise))}`
                                }).join(" ")} fill="none" stroke="#f6ad55" strokeWidth="2"/>
                            </svg>
                            <div className="text-sm">
                                <label className="block text-slate-400">Noise Amplitude</label>
                                <input type="range" min="0" max="0.5" step="0.01" value={p} onChange={e=>setP(parseFloat(e.target.value))} className="w-full accent-orange-500" />
                            </div>
                            <div className="mt-2 text-xs text-slate-400">
                                Result: {p > 0.45 ? <span className="text-red-400 font-bold">Bit Error! Noise crossed threshold.</span> : <span className="text-green-400">Signal safely decoded.</span>}
                            </div>
                        </Card>

                        <Card>
                            <h3 className="text-xl font-bold mb-4 text-brand-400">Quantum Error Correction</h3>
                            <p className="text-sm text-slate-300 mb-4">Quantum states cannot be copied (No-Cloning Theorem) and don't have natural restoring thresholds. We use redundant encoding.</p>
                            
                            <div className="bg-slate-900 p-4 rounded mb-4">
                                <h4 className="font-bold text-sm mb-2">3-Qubit Bit Flip Code</h4>
                                <div className="space-y-2 text-sm text-slate-300">
                                    <div className="flex justify-between"><span>Unprotected Fidelity:</span> <span className="text-red-400">{(pUnprotected*100).toFixed(1)}%</span></div>
                                    <div className="flex justify-between border-t border-slate-700 pt-2"><span>Protected Fidelity:</span> <span className="text-green-400">{(pProtected*100).toFixed(1)}%</span></div>
                                </div>
                                <div className="w-full bg-slate-700 h-2 mt-2 rounded-full overflow-hidden flex">
                                    <div className="bg-red-500 h-full opacity-50" style={{width: `${pUnprotected*100}%`}}></div>
                                    <div className="bg-green-500 h-full" style={{width: `${(pProtected-pUnprotected)*100}%`}}></div>
                                </div>
                            </div>
                            <div className="text-sm">
                                <label className="block text-slate-400">Error Probability (p)</label>
                                <input type="range" min="0" max="0.5" step="0.01" value={p} onChange={e=>setP(parseFloat(e.target.value))} className="w-full accent-brand-500" />
                            </div>
                        </Card>
                    </div>

                    <Card className="mt-6">
                        <h3 className="font-bold mb-2">Investigation Log</h3>
                        <p className="text-sm text-slate-400 mb-2">How does classical noise thresholding differ conceptually from quantum error correction?</p>
                        <textarea className="w-full bg-slate-900 border border-slate-700 rounded p-3 text-sm text-slate-200 focus:outline-none focus:border-brand-500" rows="3" placeholder="Write your observations here..."></textarea>
                    </Card>
                </div>
            );
        };

        const Assessment = () => {
            const questions = [
                { q: "What does the classical NOT gate correspond to in a quantum circuit?", opts: ["Hadamard (H)", "Pauli-X (X)", "Pauli-Z (Z)", "CNOT"], a: 1 },
                { q: "A transistor encodes a 1 or 0 using voltage. How does a qubit encode information?", opts: ["Current loops", "Frequency modulation", "Probability amplitudes", "Resistance"], a: 2 },
                { q: "Applying a Hadamard (H) gate to |0⟩ produces:", opts: ["|1⟩", "|0⟩", "Equal superposition |+⟩", "Phase flip |-⟩"], a: 2 },
                { q: "Unlike digital circuits that restore signals via thresholds, quantum circuits handle noise using:", opts: ["Schmitt triggers", "Quantum Error Correction codes", "Amplifiers", "Pull-up resistors"], a: 1 },
                { q: "What is the result of measuring a qubit in the state |+⟩ in the computational basis?", opts: ["Always 1", "Always 0", "50% chance of 0, 50% chance of 1", "An error"], a: 2 }
            ];
            
            const [answers, setAnswers] = useState(Array(questions.length).fill(null));
            const [submitted, setSubmitted] = useState(false);

            const score = answers.reduce((acc, val, i) => acc + (val === questions[i].a ? 1 : 0), 0);

            return (
                <div className="fade-in max-w-3xl mx-auto">
                    <h2 className="text-3xl font-bold mb-6">Knowledge Check</h2>
                    
                    {!submitted ? (
                        <div className="space-y-6">
                            {questions.map((q, i) => (
                                <Card key={i}>
                                    <p className="font-semibold mb-3">{i+1}. {q.q}</p>
                                    <div className="space-y-2">
                                        {q.opts.map((opt, j) => (
                                            <label key={j} className="flex items-center gap-3 p-3 rounded bg-slate-900 hover:bg-slate-700 cursor-pointer border border-transparent has-[:checked]:border-brand-500 has-[:checked]:bg-brand-900/20 transition-all">
                                                <input type="radio" name={`q${i}`} checked={answers[i] === j} onChange={() => { let a=[...answers]; a[i]=j; setAnswers(a); }} className="text-brand-500 focus:ring-brand-500 bg-slate-700 border-slate-600" />
                                                <span>{opt}</span>
                                            </label>
                                        ))}
                                    </div>
                                </Card>
                            ))}
                            <Button onClick={()=>setSubmitted(true)} active className="w-full justify-center text-lg py-3">Submit Answers</Button>
                        </div>
                    ) : (
                        <Card className="text-center py-10">
                            <span className="material-symbols-outlined text-6xl text-green-500 mx-auto mb-4">check_circle</span>
                            <h3 className="text-3xl font-bold mb-2">Score: {score} / {questions.length}</h3>
                            <p className="text-slate-400 mb-6">You've successfully bridged the gap from Transistors to Qubits!</p>
                            <Button onClick={()=>{setSubmitted(false); setAnswers(Array(questions.length).fill(null));}} variant="outline" className="mx-auto">Try Again</Button>
                        </Card>
                    )}
                </div>
            );
        };

        const LabGuide = () => (
            <div className="fade-in max-w-4xl mx-auto space-y-6">
                <h2 className="text-3xl font-bold">Hardware Lab Guide</h2>
                <p className="text-slate-400">Physical implementation checklist for the hybrid learning flow.</p>

                <Card>
                    <h3 className="text-xl font-bold mb-4">Part 1: The Classical Build</h3>
                    <div className="flex flex-col md:flex-row gap-6">
                        <div className="flex-1 space-y-2 text-sm text-slate-300">
                            <p><strong>Components Needed:</strong></p>
                            <ul className="list-disc pl-5 space-y-1">
                                <li>1x NPN Transistor (e.g., 2N3904)</li>
                                <li>1x 330Ω Resistor (LED limit)</li>
                                <li>1x 10kΩ Resistor (Base current limit)</li>
                                <li>1x LED</li>
                                <li>Breadboard & Jumper Wires</li>
                                <li>Arduino / ESP32 (for applying V_in)</li>
                            </ul>
                            <p className="mt-4"><strong>Workflow:</strong> Build the physical transistor inverter circuit. Write an Arduino sketch to toggle a digital pin and read the resulting analog voltage across the LED to observe the threshold behavior.</p>
                        </div>
                        <div className="flex-1 bg-slate-900 rounded p-4 border border-slate-700 font-mono text-xs text-green-400 overflow-x-auto">
                            {'void setup() {\n  pinMode(2, OUTPUT);\n  Serial.begin(9600);\n}\n\nvoid loop() {\n  digitalWrite(2, HIGH);\n  delay(1000);\n  digitalWrite(2, LOW);\n  delay(1000);\n}'}
                        </div>
                    </div>
                </Card>

                <Card>
                    <h3 className="text-xl font-bold mb-4">Part 2: The Quantum Mapping</h3>
                    <p className="text-sm text-slate-300 mb-4">Once you have verified the classical NOT gate works physically, open the <strong>Quantum Simulator</strong> (Module C) in this app or head to IBM Quantum Composer.</p>
                    <ul className="list-disc pl-5 text-sm text-slate-300 space-y-2">
                        <li>Implement a 1-qubit circuit with an X gate.</li>
                        <li>Observe how the measurement mirrors your LED turning ON/OFF.</li>
                        <li>Replace the X gate with a Hadamard (H) gate. Notice how there is no classical breadboard equivalent for this single step!</li>
                    </ul>
                </Card>
            </div>
        );


        // --- MAIN APP COMPONENT ---
        const App = () => {
            const [page, setPage] = useState('home');
            const [progress, setProgress] = useState(0);

            const menu = [
                { id: 'home', icon: 'home', label: 'Home' },
                { id: 'map', icon: 'map', label: 'Concept Map' },
                { id: 'lvl1', icon: 'memory', label: 'Level 1: Transistor' },
                { id: 'lvl2', icon: 'toggle_off', label: 'Level 2: Logic Gate' },
                { id: 'lvl3', icon: 'track_changes', label: 'Level 3: Bit → Qubit' },
                { id: 'modC', icon: 'deployed_code', label: 'Quantum Simulator' },
                { id: 'noise', icon: 'show_chart', label: 'Noise Lab' },
                { id: 'assess', icon: 'fact_check', label: 'Assessment' },
                { id: 'guide', icon: 'menu_book', label: 'Lab Guide' },
            ];

            useEffect(() => {
                const idx = menu.findIndex(m => m.id === page);
                setProgress(((idx) / (menu.length - 1)) * 100);
                window.scrollTo(0,0);
            }, [page]);

            const renderPage = () => {
                switch(page) {
                    case 'home': return <Home setPage={setPage} />;
                    case 'map': return <ConceptMap setPage={setPage} />;
                    case 'lvl1': return <Level1 setPage={setPage} />;
                    case 'lvl2': return <Level2 setPage={setPage} />;
                    case 'lvl3': return <Level3 setPage={setPage} />;
                    case 'modC': return <ModuleC />;
                    case 'noise': return <NoiseLab />;
                    case 'assess': return <Assessment />;
                    case 'guide': return <LabGuide />;
                    default: return <Home setPage={setPage} />;
                }
            }

            return (
                <div className="flex h-screen overflow-hidden bg-slate-900 text-slate-100">
                    <div className="w-64 bg-slate-800 flex-shrink-0 hidden md:flex flex-col border-r border-slate-700">
                        <div className="p-4 border-b border-slate-700">
                            <h1 className="font-bold text-lg text-transparent bg-clip-text bg-gradient-to-r from-brand-400 to-purple-400">Transistors to Qubits</h1>
                        </div>
                        <div className="flex-1 overflow-y-auto py-4">
                            <ul className="space-y-1 px-2">
                                {menu.map(item => (
                                    <li key={item.id}>
                                        <button 
                                            onClick={() => setPage(item.id)}
                                            className={`w-full flex items-center gap-3 px-3 py-2 rounded-lg text-sm transition-colors ${page === item.id ? 'bg-brand-600 text-white' : 'text-slate-300 hover:bg-slate-700 hover:text-white'}`}>
                                            <span className="material-symbols-outlined">{item.icon}</span>
                                            {item.label}
                                        </button>
                                    </li>
                                ))}
                            </ul>
                        </div>
                        <div className="p-4 border-t border-slate-700 text-xs text-slate-500 text-center">
                            EE Hybrid Learning Framework
                        </div>
                    </div>

                    <div className="flex-1 flex flex-col relative overflow-hidden">
                        <div className="md:hidden flex items-center justify-between p-4 bg-slate-800 border-b border-slate-700">
                            <h1 className="font-bold text-transparent bg-clip-text bg-gradient-to-r from-brand-400 to-purple-400">Transistors to Qubits</h1>
                            <select value={page} onChange={(e)=>setPage(e.target.value)} className="bg-slate-700 text-sm rounded p-1">
                                {menu.map(m => <option key={m.id} value={m.id}>{m.label}</option>)}
                            </select>
                        </div>

                        <div className="h-1 w-full bg-slate-800 absolute top-0 left-0 z-50 hidden md:block">
                            <div className="h-full bg-gradient-to-r from-brand-500 to-purple-500 transition-all duration-500 ease-out" style={{width: `${progress}%`}}></div>
                        </div>

                        <div className="flex-1 overflow-y-auto p-4 md:p-8 relative">
                            {renderPage()}
                        </div>
                    </div>
                </div>
            );
        };

        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(<App />);
    </script>
</body>
</html>
